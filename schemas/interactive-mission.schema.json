{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oeb:interactive-mission:1.0.0",
  "title": "InteractiveMissionContract",
  "description": "Declarative deterministic mission definition for an OEB real-time runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "title",
    "summary",
    "runtime_scene",
    "player",
    "environment",
    "entities",
    "steps",
    "sensors",
    "interactions",
    "failure_rules",
    "completion"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "mission_id": { "$ref": "#/$defs/logical_id" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "runtime_scene": {
      "type": "string",
      "pattern": "^res://generated/scenes/missions/[a-zA-Z0-9_/-]+\\.tscn$"
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "contract_id", "spawn"],
      "properties": {
        "instance_id": { "$ref": "#/$defs/logical_id" },
        "contract_id": { "$ref": "#/$defs/logical_id" },
        "spawn": { "$ref": "#/$defs/transform" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space_preset", "entry_boundary", "obstacles"],
      "properties": {
        "space_preset": { "const": "deep_space" },
        "entry_boundary": { "$ref": "#/$defs/boundary" },
        "obstacles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/placement" }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "contract_id", "mission_role", "transform"],
        "properties": {
          "instance_id": { "$ref": "#/$defs/logical_id" },
          "contract_id": { "$ref": "#/$defs/logical_id" },
          "mission_role": { "enum": ["primary_target", "secondary_target"] },
          "transform": { "$ref": "#/$defs/transform" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "state", "verb", "objective"],
        "properties": {
          "step_id": { "$ref": "#/$defs/logical_id" },
          "state": { "$ref": "#/$defs/mission_state" },
          "verb": {
            "enum": ["BRIEF", "LOCATE", "APPROACH", "DOWNLOAD", "TRACTOR", "RETURN", "EXIT", "HYPERSPACE", "COMPLETE"]
          },
          "objective": { "type": "string", "minLength": 1 },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/mission_state" }
          }
        }
      }
    },
    "sensors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_instance_id", "detection_range_m", "bearing_range_m", "strength_range_m", "identification_range_m", "identification_dwell_s", "visual_range_m"],
      "properties": {
        "target_instance_id": { "$ref": "#/$defs/logical_id" },
        "detection_range_m": { "$ref": "#/$defs/positive_number" },
        "bearing_range_m": { "$ref": "#/$defs/positive_number" },
        "strength_range_m": { "$ref": "#/$defs/positive_number" },
        "identification_range_m": { "$ref": "#/$defs/positive_number" },
        "identification_dwell_s": { "$ref": "#/$defs/positive_number" },
        "visual_range_m": { "$ref": "#/$defs/positive_number" }
      }
    },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["download", "tow"],
      "properties": {
        "download": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_instance_id", "range_m", "max_relative_speed_mps", "duration_s", "requires_line_of_sight"],
          "properties": {
            "target_instance_id": { "$ref": "#/$defs/logical_id" },
            "range_m": { "$ref": "#/$defs/positive_number" },
            "max_relative_speed_mps": { "$ref": "#/$defs/positive_number" },
            "duration_s": { "$ref": "#/$defs/positive_number" },
            "requires_line_of_sight": { "type": "boolean" }
          }
        },
        "tow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_instance_id", "range_m", "max_relative_speed_mps", "tow_length_m", "latch_duration_s", "source_marker_role", "target_marker_role"],
          "properties": {
            "target_instance_id": { "$ref": "#/$defs/logical_id" },
            "range_m": { "$ref": "#/$defs/positive_number" },
            "max_relative_speed_mps": { "$ref": "#/$defs/positive_number" },
            "tow_length_m": { "$ref": "#/$defs/positive_number" },
            "latch_duration_s": { "$ref": "#/$defs/positive_number" },
            "source_marker_role": { "const": "effect_exclusion_center" },
            "target_marker_role": { "const": "tow_anchor" }
          }
        }
      }
    },
    "failure_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_collision_disables_download",
        "damaged_probe_remains_towable",
        "probe_weapon_hit_state"
      ],
      "properties": {
        "probe_collision_disables_download": { "const": true },
        "damaged_probe_remains_towable": { "const": true },
        "probe_weapon_hit_state": { "const": "FAILED" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["return_boundary_id", "require_tow_attached", "hyperspace_required"],
      "properties": {
        "return_boundary_id": { "$ref": "#/$defs/logical_id" },
        "require_tow_attached": { "const": true },
        "hyperspace_required": { "const": true }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "logical_id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_]*$"
    },
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "positive_vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation_degrees", "scale"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "rotation_degrees": { "$ref": "#/$defs/vector3" },
        "scale": { "$ref": "#/$defs/positive_vector3" }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "contract_id", "transform"],
      "properties": {
        "instance_id": { "$ref": "#/$defs/logical_id" },
        "contract_id": { "$ref": "#/$defs/logical_id" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "center", "radius_m"],
      "properties": {
        "boundary_id": { "$ref": "#/$defs/logical_id" },
        "center": { "$ref": "#/$defs/vector3" },
        "radius_m": { "$ref": "#/$defs/positive_number" }
      }
    },
    "mission_state": {
      "type": "string",
      "enum": [
        "BRIEFING",
        "LOCATE",
        "APPROACH",
        "DOWNLOAD_READY",
        "DOWNLOADING",
        "DATA_SECURED",
        "TOW_READY",
        "IN_TOW",
        "RETURN_TO_ENTRY",
        "EXIT_READY",
        "HYPERSPACE",
        "FAILED",
        "COMPLETE"
      ]
    }
  }
}
